{
  "manifest_version": 3,
  "name": "Play in VLC",
  "version": "1.1",
  "description": "Intercepts HLS/DASH streams and sends them to VLC",

  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "tabs",
    "webRequest",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icon16.png",
      "48":  "icon48.png",
      "128": "icon128.png"
    }
  },

  "icons": {
    "16":  "icon16.png",
    "48":  "icon48.png",
    "128": "icon128.png"
  }
}
